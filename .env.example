APP_NAME="Realtime Terms Backend"
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

SQLITE_PATH=data/app.sqlite3

# Set to false to skip loading the local Whisper entirely (use an API provider
# from the app settings instead). Saves the multi-GB model download and VRAM.
WHISPER_ENABLED=true
# faster-whisper size (large-v3-turbo, medium, ...) или nemotron-3.5-asr-streaming-0.6b —
# локальная NVIDIA-модель с настоящим стримингом и пунктуацией (нужен pip install -e ".[nemotron]").
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
ASR_MIN_AUDIO_SECONDS=1.5
ASR_MAX_BUFFER_SECONDS=30
# How much new audio to accumulate between transcriptions. Lower = more responsive
# but more GPU work; too low makes the transcript lag behind live speech.
ASR_TRANSCRIBE_INTERVAL_SECONDS=0.6
# Mic chunks quieter than this RMS (0..1) are treated as silence and dropped, so
# pausing does not erase the transcript. Raise if silence still erodes text (noisy
# mic / AGC); lower if quiet speech gets cut off.
ASR_SILENCE_RMS_THRESHOLD=0.01
ASR_LANGUAGE=ru
# Nemotron only: сколько «заглядывать вперёд» (мс). Поддерживается 0 / 240 / 480 / 1040.
# Больше — заметно точнее на редких терминах и пунктуации, но частичный текст
# приходит с такой задержкой. 1040 — оптимум для лекций.
NEMOTRON_LOOKAHEAD_MS=1040
# Domain vocabulary hint for Whisper: listed terms are recognized far more reliably.
# ASR_INITIAL_PROMPT="Собеседование по разработке: React, TypeScript, замыкание, event loop, хук, рендер, микросервис, кэш, REST, SQL."

LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
# Не занижайте: JSON-ответ на русском легко превышает 512 токенов, а у
# reasoning-моделей размышления тоже тратят этот бюджет — обрезанный JSON
# не парсится и даёт LLM_BAD_RESPONSE.
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=1024
OLLAMA_NUM_GPU=999
OLLAMA_MAIN_GPU=0
OLLAMA_THINK=false
LLM_CONTEXT_CHARS=500

# Provider selection. Normally chosen interactively at backend startup
# (backend.cmd / ./backend.sh) and written here, so you rarely edit by hand.
# LLM_PROVIDER keys: ollama | openai | anthropic | deepseek | zai | minimax | gemini
LLM_PROVIDER=ollama
# Used only when LLM_PROVIDER is not ollama. Empty model/base_url = provider default.
LLM_API_KEY=
LLM_API_MODEL=
LLM_API_BASE_URL=

# Whisper provider: local (faster-whisper on this box), api (OpenAI-compatible
# /audio/transcriptions) or yandex (SpeechKit v3 gRPC streaming — распознавание в
# реальном времени, партиалы приходят по мере речи). The launcher sets these.
WHISPER_PROVIDER=local
WHISPER_API_KEY=
WHISPER_API_MODEL=
WHISPER_API_BASE_URL=

# Yandex SpeechKit (WHISPER_PROVIDER=yandex): API-ключ сервисного аккаунта с ролью
# ai.speechkit-stt.user. Требует опциональных зависимостей: pip install -e ".[yandex]"
YANDEX_STT_API_KEY=
YANDEX_STT_MODEL=general
# Пунктуация и заглавные буквы в финальном (закоммиченном) тексте. Партиалы по
# ходу речи всегда без пунктуации — так устроен API.
YANDEX_STT_PUNCTUATION=true

TERM_MIN_CHARS=3
TERM_MAX_WORDS=5
# Lower = more terms but more junk (single common nouns start at 0.62); higher =
# only multi-word phrases and technical tokens. Tune to taste.
TERM_CONFIDENCE_THRESHOLD=0.68
